{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "yarn build",
  "outputDirectory": "_site",
  "headers": [
    {
      "source": "/resume/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ],
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "salemcobalt.com" }],
      "destination": "https://salemcobalt.com/:path",
      "permanent": true
    },
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "www.salemcobalt.com" }],
      "destination": "https://salemcobalt.com/:path",
      "permanent": true
    },
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "www.salemcobalt.com" }],
      "destination": "https://salemcobalt.com/:path",
      "permanent": true
    }
  ]
}
