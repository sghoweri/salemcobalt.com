{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "yarn build",
  "outputDirectory": "_site",
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "salemghoweri.com" }],
      "destination": "https://salemcobalt.com/:path",
      "permanent": true
    },
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "www.salemghoweri.com" }],
      "destination": "https://salemcobalt.com/:path",
      "permanent": true
    },
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "www.salemcobalt.com" }],
      "destination": "https://salemcobalt.com/:path",
      "permanent": true
    }
  ]
}
